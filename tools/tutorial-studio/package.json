{
  "name": "golden-plate-tutorial-studio",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Local, deterministic frontend tutorial renderer. No screen recording or Remotion.",
  "scripts": {
    "doctor": "node cli.mjs doctor",
    "preview": "node cli.mjs preview",
    "storyboard": "node cli.mjs storyboard",
    "render": "node cli.mjs render",
    "verify": "node cli.mjs verify",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser-check.mjs"
  },
  "dependencies": { "playwright": "1.62.1" },
  "engines": { "node": ">=22" }
}
