# Optional local/staging public v3 key. Production has its own public-key file.
VITE_RECAPTCHA_SITE_KEY=

# Mapbox public browser token (pk.), required for the public school map.
# Put the real value in ignored frontend/.env.local or the frontend build environment.
# China (CN) worldview is fixed in the map; Hybrid is the default layer.
VITE_MAPBOX_ACCESS_TOKEN=
