# Optional local/staging Turnstile public key. Production has its own public-key file.
VITE_TURNSTILE_SITE_KEY=

# Mapbox public browser token (pk.), required for the public school map.
# Prefer the root .env; this is a fallback if the root variable is absent.
# China (CN) worldview is fixed in the map; Hybrid is the default layer.
VITE_MAPBOX_ACCESS_TOKEN=

# Optional public Google OAuth Web client ID for creating school decks in Google Slides.
# Set this in the frontend build environment or frontend/.env.local, then rebuild.
VITE_GOOGLE_SLIDES_CLIENT_ID=
