# Flask/Application Configuration
# Change an existing username/password with:
# venv/bin/python scripts/change_user_credentials.py
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

# Brevo Email Service Configuration
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=no-reply@yourdomain.com

# Website updates always notify matthew.jaekel@sac.on.ca.
# Optional additional recipients (comma-separated):
WEBSITE_UPDATE_NOTIFY_EMAILS=
WEBSITE_PUBLIC_URL=https://goldenplate.ca

# reCAPTCHA v3 Configuration (required in production)
# Use the matching v3 legacy secret key from https://www.google.com/recaptcha/admin
# Never put this secret in a VITE_ variable or frontend file.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=goldenplate.ca,www.goldenplate.ca,map.goldenplate.ca
