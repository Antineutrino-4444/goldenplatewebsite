# Flask/Application Configuration
# Change an existing username/password with:
# venv/bin/python scripts/change_user_credentials.py
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

# Brevo Email Service Configuration
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=no-reply@yourdomain.com

# All website update recipients (comma-separated). Add/remove addresses here.
# Leave empty to disable website-wide alerts (school contacts still get signups).
WEBSITE_UPDATE_NOTIFY_EMAILS=matthew.jaekel@sac.on.ca
# Automatic announcement when the application initializes after a start/reload.
WEBSITE_STARTUP_NOTIFY_ENABLED=true
# Optional additional map reviewers. The Map admin UI can override this list.
# Map submissions also notify WEBSITE_UPDATE_NOTIFY_EMAILS recipients.
MAP_APPROVAL_NOTIFY_EMAILS=

# Optional Photon-compatible place search service (no key required by default).
MAP_PLACE_SEARCH_URL=https://photon.komoot.io/api/
# Archived ecological map endpoints are disabled by default.
MAP_LEGACY_FEATURES_ENABLED=false
WEBSITE_PUBLIC_URL=https://goldenplate.ca

# Cloudflare Turnstile configuration (required in production)
# Use the matching secret from the Cloudflare Turnstile widget dashboard.
# Never put this secret in a VITE_ variable or frontend file.
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=goldenplate.ca,www.goldenplate.ca,map.goldenplate.ca
# Public site key for scripts/test_emails.py (the matching secret is above).
# Alternatively the tool can use VITE_TURNSTILE_SITE_KEY from this environment.
TURNSTILE_SITE_KEY=
# Optional fixed operator key for the standalone email test form.
# If empty, the script generates and displays a new key each time it starts.
EMAIL_TEST_ACCESS_KEY=

# Mapbox public browser token (pk.), read by frontend builds from this root file.
# Rebuild the frontend after changing it. Never use a secret (sk.) token here.
VITE_MAPBOX_ACCESS_TOKEN=
